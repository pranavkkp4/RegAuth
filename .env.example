# Copy this file to .env and replace the placeholder values locally.
# Never commit real API keys.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: local backend endpoint used by the browser app.
VITE_AGENT_API_URL=http://localhost:3001/api/agent
AGENT_SERVER_PORT=3001
AGENT_CORS_ORIGIN=http://localhost:3000

# Optional: set only if your Anthropic account/model requires a beta header.
# ANTHROPIC_BETA=prompt-caching-2024-07-31
